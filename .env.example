# Copy to .env; do not overwrite existing private settings. Never commit .env.
CLASSIFIER_PROVIDER=local

# Example model; there is no model name default in code. Install explicitly.
LOCAL_LLM_MODEL=qwen3:4b
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434
LOCAL_LLM_TIMEOUT=180
LOCAL_LLM_VALIDATION_RETRIES=1

# Optional: used ONLY when CLASSIFIER_PROVIDER=openai.
# OPENAI_API_KEY=your_api_key_here

# A Structured Outputs-capable model. Override this without changing source code.
OPENAI_MODEL=gpt-4o-mini

# Set OLLAMA_NO_CLOUD=1 in the Ollama SERVER environment, then restart it.
# An app .env entry alone cannot configure an already running Ollama server.

# Optional. Defaults to data/papers.db relative to the repository root.
# DATABASE_PATH=data/papers.db

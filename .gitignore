# Secrets
.env
.env.*
!.env.example

# Source papers and personal data
papers/*
!papers/inbox/
papers/inbox/*
!papers/inbox/.gitkeep
*.[pP][dD][fF]
data/*
!data/.gitkeep
# Public schema template only; keep real evaluation rows in ignored local copies.
!data/ground_truth.csv
logs/*
!logs/.gitkeep
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.log
*.log.*

# Streamlit local secrets and caches (keep .streamlit/config.toml)
.streamlit/secrets.toml
.streamlit/credentials.toml
.streamlit/cache/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
env/

# Temporary and backup files
*.tmp
*.temp
*.bak
*.swp
*~
~$*

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db
